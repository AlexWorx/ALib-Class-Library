//-------------------------------------- module variables ------------------------------------
VARE<        variables::
VARE ~|
    0,     OK                  ,     ,
    1,     ErrorOpeningFile    ,VARERF,
    2,     ErrorWritingFile    ,VAREWF

VARERF     "Can't open {}file {!Q'} for reading."
VAREWF     "Can't open {}file {!Q'} for writing."

VarPrio ~|
        0,   NONE              ,1,
     1000,   AutoDetected      ,1,
     2000,   DefaultValues     ,1,
     4000,   Standard          ,1,
     6000,   ConfigFile        ,2,
     8000,   Environment       ,1,
    10000,   SessionFile       ,8,
    12000,   CLI               ,2,
    14000,   Session           ,2,
      max,   Protected         ,1

// names of the configuration plug-ins added to configuration in default construction.
CFGPlgEnv   "Environment Variables"
CFGPlgCLI   "Command Line Arguments"

CFGIniWB    writeback

// boolean tokens
CFGBTF ~|
    "False I 1,"   "True I 1,"
        "0 I 1,"     "1 I 1,"
       "No I 1,"    "Yes I 1,"
      "Off I 3,"     "On I 2,"
      "--- I 1,"     "OK I 2"


// variables
// DOX_MARKER([DOX_VARIABLES_DECLARATION6])
Var0 ~  1 | ALIB/LOCALE             | S
Var1 ~  2 | ALIB/WAIT_FOR_KEY_PRESS | B
Var2 ~  3 | ALIB/HAS_CONSOLE_WINDOW | B

Var_C1 >
    Defines the locale of the application. If empty or not set, the system's locale is used.\n
    If set, a UTF8 locale should be used, for example, 'us_US.UTF-8' or 'de_DE.UTF-8'
Var_C2 >
    If true, the process waits for a key stroke on termination. If empty, under Windows\n
    the behavior is detected, under other OSes, it defaults to false.
Var_C3 >
    Boolean value that denotes what its name indicates. If empty, under Windows the value is\n
    detected, under other OSes, it defaults to true.
// DOX_MARKER([DOX_VARIABLES_DECLARATION6])


// INI-File comment for section ALIB
CFG_SECT_CMT_ALIB  "@>'/// '@HL-General ALib library settings.\n@HL-)"

// Exit message when waiting for key-press requested with variable WAIT_FOR_KEY_PRESS
EXIT_MSG           "ALIB: Press 'Enter' to exit..."

ACAlgos ~|
     0,    NONE                 ,1,
    31,    ALL                  ,1,
     1,    Uncompressed         ,1,
     2,    MinMax               ,1,
     4,    Sparse               ,1,
     8,    VerySparse           ,1,
    16,    Incremental          ,1,
    32,    Huffman              ,1

// Calendar
Months   January,February,March,April,May,June,July,August,September,October,November,December
Days     Sunday,Monday,Tuesday,Wednesday,Thursday,Friday,Saturday

//  0  TS_ZERO, 1  DayP, 2  DayS, 3  HourP, 4  HourS, 5  MinP, 6  MinS,
//  7  SecP, 8  SecS, 9  MlSecP, 10  MlSecS, 11  McSecP, 12  McSecS, 13  NSecP, 14  NSecS

DurUnts ~|
    "zero time",
    " days"      ,
    " day"       ,
    " hours"     ,
    " hour"      ,
    " minutes"   ,
    " minute"    ,
    " seconds"   ,
    " second"    ,
    " ms"        ,
    " ms"        ,
    " \u03BCs"   ,
    " \u03BCs"   ,
    " ns"        ,
    " ns"

// default format string for DateTime values used by FFormat_DateTime()
FMTDT     "yyyy-MM-dd HH:mm:ss"

// default format string for CallerInfo values used by FFormat_CallerInfo()
FMTCI     "[@ sf:sl from ''ya'' by ''ta'']"

// format output if CallerInfo has no thread set
FMTCINT   "<None>"

// format output if CallerInfo originates from static method or namespace function
FMTCINY   "<None>"

// format output if CallerInfo originates from static method or namespace function
FMTCINR   "<Null>"

// Enums
SF ~|
    0,  Root        ,1,
    1,  Current     ,1,
    3,  HomeConfig  ,5,
    2,  Home        ,1,
    4,  Module      ,1,
    5,  Temp        ,1,
    6,  VarTemp     ,1


//---------------------------------------- module exceptions ---------------------------------------
ExcFmtExc   "\nAn exception occurred while formatting another (!) exception:\n"

//------------------------------------------ module format -----------------------------------------
PHT ~|
    0,  NotGiven          ,1,
    1,  String            ,1,
    2,  Character         ,1,
    3,  IntBase10         ,6,
    4,  IntBinary         ,6,
    5,  IntOctal          ,6,
    6,  IntHex            ,6,
    7,  Float             ,1,
    8,  Bool              ,1,
    9,  HashCode          ,1,
   10,  Fill              ,4


// general formatter errors
FE<   format::

FE0 ~    11,ArgumentIndexIs0                       ,FMG11
FE1 ~    12,ArgumentIndexOutOfBounds               ,FMG12
FE2 ~    13,IncompatibleTypeCode                   ,FMG13

// Formatter Python Style
FE3  ~  101,MissingClosingBracket                 ,FPS101
FE4  ~  102,MissingPrecisionValuePS               ,FPS102
FE5  ~  103,DuplicateTypeCode                     ,FPS103
FE6  ~  104,UnknownTypeCode                       ,FPS104
FE7  ~  105,ExclamationMarkExpected               ,FPS105
FE8  ~  106,UnknownConversionPS                   ,FPS106
FE9  ~  107,PrecisionSpecificationWithInteger     ,FPS107
FE10 ~  108,MissingReplacementStrings             ,FPS108

// Formatter Java Style
FE11 ~  201,NegativeValuesInBracketsNotSupported ,FJS101
FE12 ~  202,MissingPrecisionValueJS              ,FJS102
FE13 ~  203,HexadecimalFloatFormatNotSupported   ,FJS103
FE14 ~  204,NoAlternateFormOfConversion          ,FJS104
FE15 ~  205,NoPrecisionWithConversion            ,FJS105
FE16 ~  206,UnknownDateTimeConversionSuffix      ,FJS106
FE17 ~  207,UnknownConversionJS                  ,FJS107

// PropertyFormatter and PropertyFormatters
FE18 ~  501,UnknownPropertyInFormatString        ,PFM501
FE19 ~  502,ErrorInResultingFormatString         ,PFM502
FE20 ~  510,MissingConfigurationVariable         ,PFM510

// class Paragraphs
FE21 ~  601,UnknownMarker                        ,ST601
FE22 ~  602,EndmarkerWithoutStart                ,ST602

// general formatter errors
FMG11 >|
    Argument index 0 not allowed.\n
    In: {!Q}\n    >{!FillC-}^
FMG12 >|
    Argument index #{} is out of bounds. {} arguments are available.\n
    In: {!Q}\n    >{!FillC-}^
FMG13 >|
    Detected placeholder type does not match given argument.\n
    Placeholder number:    {}\n
    Placeholder type:      {} ({})\n
    Deduced argument type: {!Q}\n
    In: {!Q}\n    >{!FillC-}^

// Formatter Python Style
FPS101 >|
    Closing bracket '}}' of placeholder not found (or syntax error).\n
    In: {!Q}\n    >{!FillC-}^
FPS102 >|
   Missing precision value after '.' character.\n
   In: {!Q}\n    >{!FillC-}^
FPS103 >|
   Duplicate type code {!Q'} given (previous was {!Q'}).\n
   In: {!Q}\n    >{!FillC-}^

FPS104 >|
    Unknown type code {!Q'} given.\n
    In: {!Q}\n    >{!FillC-}^

FPS105 >|
    Expected '!' in continuation of placeholder.\n
    In: {!Q}\n    >{!FillC-}^

FPS106 >|
    Unknown conversion \"!{}\".\n
    In: {!Q}\n    >{!FillC-}^

FPS107 >|
    Precision not allowed with integer format.\n
    In: {!Q}\n    >{!FillC-}^

FPS108 >|
    Missing pair of replacement strings \"<src><repl>\" after \"!Replace\".\n
    In: {!Q}\n    >{!FillC-}^

// Formatter Java Style
FJS101 >|
    Brackets for negative values not implemented/supported.\n
    In: {!Q}\n    >{!FillC-}^
FJS102 >|
    Missing precision value after '.' character.\n
    In: {!Q}\n    >{!FillC-}^
FJS103 >|
    Hexadecimal float format not implemented/supported.\n
    In: {!Q}\n    >{!FillC-}^
FJS104 >|
    Alternate form '#' not supported with conversion {!Q}.\n
    In: {!Q}\n    >{!FillC-}^
FJS105 >|
    Precision specification (\.{}\) is not supported with conversion {!Q}.\n
    In: {!Q}\n    >{!FillC-}^
FJS106 >|
    Unknown date/time conversion suffix {!Q'}.\n
    In: {!Q}\n    >{!FillC-}^
FJS107 >|
    Unknown conversion character {!Q'}.\n
    In: {!Q}\n    >{!FillC-}^


// PropertyFormatter and PropertyFormatters
PFM501 >|
    Unknown property identifier \{}{}\ in format string.\n
    Format string: {!Q}.\n
    Allowed identifiers:
PFM502  Error in resulting format string.\nSource format: {!Q}.
PFM510  Missing or empty configuration variable {!Q} containing user-defined format string.

// class Paragraphs
ST601 >|
    Unknown marker at position {}.
    \n  Marked text: {!Q}.
    \n               >{!FillC-}^
ST602 >|
    Found an end-marker without a start marker at position {}.
    \n  Marked text: {!Q}.
    \n               >{!FillC-}^\n

